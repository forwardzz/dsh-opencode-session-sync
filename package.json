{
  "name": "dsh-opencode-session-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness 插件：把 OpenCode 桌面端（opencode.db）的历史会话按各自原本的工作目录导入为 DSH 原生会话",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./convert": "./lib/convert.js",
    "./validate": "./lib/validate.js",
    "./opencode-db": "./lib/opencode-db.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "test",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/convert.test.mjs",
    "selfcheck": "node tools/selfcheck.mjs",
    "verify-install": "node tools/verify-install.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forwardzz/dsh-opencode-session-sync.git"
  },
  "homepage": "https://github.com/forwardzz/dsh-opencode-session-sync#readme",
  "bugs": {
    "url": "https://github.com/forwardzz/dsh-opencode-session-sync/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "session",
    "migration"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT"
}
